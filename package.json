{
  "name": "fixo-cli",
  "version": "1.0.0",
  "description": "FixO CLI — Autonomous Free Multi-Provider LLM Coding Tool",
  "type": "module",
  "bin": {
    "fixo": "./dist/index.js",
    "fixo-cli": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "node --import tsx --test src/__tests__/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "coding",
    "agent",
    "cli",
    "llm",
    "free",
    "openai",
    "groq",
    "gemini",
    "claude-code-alternative"
  ],
  "license": "Apache-2.0",
  "author": "Abrar Akhunji",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abrar-Akhunji/FIXO_CLI.git"
  },
  "bugs": {
    "url": "https://github.com/Abrar-Akhunji/FIXO_CLI/issues"
  },
  "homepage": "https://github.com/Abrar-Akhunji/FIXO_CLI#readme",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.0",
    "cheerio": "^1.2.0",
    "gpt-tokenizer": "^3.4.0",
    "js-yaml": "^4.1.0",
    "tree-sitter-bash": "^0.25.0",
    "turndown": "^7.2.4",
    "vscode-jsonrpc": "^8.2.1",
    "web-tree-sitter": "^0.25.10"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.3",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
